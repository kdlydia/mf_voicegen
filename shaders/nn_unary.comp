#version 460
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430) readonly buffer FloatRef {
    float v[];
};

layout(buffer_reference, std430) buffer ResultRef {
    float v[];
};

layout(push_constant) uniform PC {
    FloatRef src;
    ResultRef dst;
    FloatRef params;
    uint count;
    uint op;
    uint inner;
    uint channels;
    float alpha;
    float beta;
} pc;

const uint OP_AFFINE = 0u;
const uint OP_EXP = 1u;
const uint OP_LOG = 2u;
const uint OP_SIN = 3u;
const uint OP_COS = 4u;
const uint OP_TANH = 5u;
const uint OP_LEAKY_RELU = 6u;
const uint OP_SILU = 7u;
const uint OP_SNAKE = 8u;
const uint OP_CLAMP = 9u;

uint invocation_index()
{
    return gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
}

/**
 * @brief sin(x) and cos(x) to about one ulp for |x| below 8192, as Cephes sinf and cosf.
 *
 * Built-in sin and cos are only bounded inside [-pi, pi] and lose accuracy
 * quickly beyond it. x is reduced to r in [-pi/4, pi/4] by a three-part pi/4,
 * then two short polynomials give sin r and cos r and the quadrant picks.
 */
vec2 sin_cos(float x)
{
    const float ax = abs(x);
    int j = int(ax * 1.27323954473516);
    j += j & 1;
    const float y = float(j);
    precise float r = ((ax - y * 0.78515625) - y * 2.4187564849853515625e-4) - y * 3.77489497744594108e-8;
    const float z = r * r;
    const float s = ((-1.9515295891e-4 * z + 8.3321608736e-3) * z - 1.6666654611e-1) * z * r + r;
    const float c = ((2.443315711809948e-5 * z - 1.388731625493765e-3) * z + 4.166664568298827e-2) * z * z - 0.5 * z + 1.0;
    const int quadrant = (j >> 1) & 3;
    vec2 result = quadrant == 0 ? vec2(s, c) : quadrant == 1 ? vec2(c, -s) : quadrant == 2 ? vec2(-s, -c) : vec2(-c, s);
    if (x < 0.0)
        result.x = -result.x;
    return result;
}

/**
 * @brief One function applied to every element of count floats. dst may be src.
 *
 * AFFINE alpha * x + beta. EXP min(exp(x), alpha). LOG log(max(x, alpha)).
 * SIN, COS, TANH. LEAKY_RELU x, or alpha * x below zero. SILU x * sigmoid(x).
 * SNAKE x + sin(a * x)^2 / a, with a taken from params at the element's
 * channel, (i / inner) % channels, or alpha when channels is 0. CLAMP
 * min(max(x, alpha), beta).
 */
void main()
{
    const uint idx = invocation_index();
    if (idx >= pc.count)
        return;

    const float x = pc.src.v[idx];
    float y = x;
    if (pc.op == OP_AFFINE) {
        y = pc.alpha * x + pc.beta;
    } else if (pc.op == OP_EXP) {
        y = min(exp(x), pc.alpha);
    } else if (pc.op == OP_LOG) {
        y = log(max(x, pc.alpha));
    } else if (pc.op == OP_SIN) {
        y = sin_cos(x).x;
    } else if (pc.op == OP_COS) {
        y = sin_cos(x).y;
    } else if (pc.op == OP_TANH) {
        y = tanh(clamp(x, -15.0, 15.0));
    } else if (pc.op == OP_LEAKY_RELU) {
        y = x >= 0.0 ? x : pc.alpha * x;
    } else if (pc.op == OP_SILU) {
        y = x / (1.0 + exp(-x));
    } else if (pc.op == OP_SNAKE) {
        const float a = pc.channels == 0u ? pc.alpha : pc.params.v[(idx / max(pc.inner, 1u)) % pc.channels];
        const float s = sin_cos(a * x).x;
        y = x + s * s / a;
    } else if (pc.op == OP_CLAMP) {
        y = min(max(x, pc.alpha), pc.beta);
    }
    pc.dst.v[idx] = y;
}
