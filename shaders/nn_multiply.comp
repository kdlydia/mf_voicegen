#version 460
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430) readonly buffer FloatRef {
    float v[];
};

layout(buffer_reference, std430) buffer ResultRef {
    float v[];
};

layout(push_constant) uniform PC {
    FloatRef a;
    FloatRef b;
    ResultRef dst;
    uint count;
    uint inner;
    uint b_count;
    uint reserved;
} pc;

uint invocation_index()
{
    return gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
}

/**
 * @brief Element-wise product of count floats of a with b repeated: dst[i] = a[i] * b[(i / inner) % b_count].
 *
 * inner 1 and b_count count multiply element by element. inner t and b_count c
 * scale each channel of a [c, t] tensor. dst may be a.
 */
void main()
{
    const uint idx = invocation_index();
    if (idx >= pc.count)
        return;
    pc.dst.v[idx] = pc.a.v[idx] * pc.b.v[(idx / max(pc.inner, 1u)) % max(pc.b_count, 1u)];
}
